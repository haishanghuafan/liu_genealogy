# Application
APP_NAME=Genealogy SaaS
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8010

# Database - SQLite (default for local development)
# No external database installation required!
DATABASE_URL=sqlite+aiosqlite:///./genealogy.db

# Database - PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/genealogy

# Database - Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379/0

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010

# File Storage (MinIO / S3)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=genealogy
STORAGE_REGION=us-east-1

# Tenant Settings
TENANT_DEFAULT_PLAN=free
TENANT_MAX_FREE_PERSONS=100
TENANT_MAX_FREE_STORAGE_MB=100
